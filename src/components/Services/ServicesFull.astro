---
import { services } from "../../data/services.json.ts";
import ServiceCard from "./ServiceCard.astro";
---

<div class="space-y-16">
  {services.map((category) => (
    <div>
      <h2 class="text-2xl font-bold uppercase mb-6">{category.category}</h2>
      {category.category === "Pressure Washing" ? (
        <p class="text-center text-lg text-gray-600 italic">🚧 Pressure Washing services are coming soon!</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {category.services.map((service) => (
            <ServiceCard {...service} />
          ))}
        </div>
      )}
    </div>
  ))}
</div>


