---
// components/ServiceCard.astro
const { name, features, carPrice,  truckPrice, image, colorClass } = Astro.props;
---

<div class="rounded-xl shadow-lg bg-white border overflow-hidden">
  <img src={image.src} alt={name} class="w-full h-48 object-cover" />
    <!-- Colored Banner Below Image -->
  <div class={`w-full text-center`}>
    <h2 class={`p-2 font-bold mb-2 ${colorClass}`}>{name}</h2>
  </div>
    <!-- Card Content -->
  <div class="p-5">
    <ul class="list-disc pl-5 text-sm text-gray-700 mb-4 space-y-1">
      {features.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    
    <div class="text-sm font-medium text-gray-800">
      <p><span class="font-bold text-primary-600">Cars:</span> Starting at ${carPrice}</p>
      <p><span class="font-bold text-primary-600">Trucks/SUVs:</span> Starting at ${truckPrice}</p>
    </div>
  </div>
</div>
