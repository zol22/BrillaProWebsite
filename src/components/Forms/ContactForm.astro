---
// components
import Button from "@components/Button/Button.astro";
---
<form method="POST" id="contact-form"
  name="contact-form"
  class="scroll-animation flex h-full flex-col justify-between gap-4 needs-validation"
  data-astro-reload
  novalidate
>
  <input type="hidden" name="access_key" value="6a4475d1-26f0-4a42-bb3b-8418521fa7bc" />

  <!-- Name -->
  <div class="col">
    <label for="contact-name" class="font-heading-1 text-lg uppercase">Your Name</label>
    <input type="text" class="form__input" name="name" id="contact-name" placeholder="Please Enter Your Name" required />
    <div class="empty-feedback invalid-feedback text-warning text-sm mt-1">Please provide your full name.</div>
  </div>

  <!-- Email -->
  <div class="col">
    <label for="contact-email" class="font-heading-1 text-lg uppercase">Contact Email</label>
    <input type="email" class="form__input" name="email" id="contact-email" inputmode="email" placeholder="Please Enter Your Email" required />
    <div class="empty-feedback text-warning text-sm mt-1">Please provide your email address.</div>
    <div class="invalid-feedback text-warning text-sm mt-1">Please enter a valid email format (e.g., you@example.com).</div>
  </div>

  <!-- Service Type -->
  <div class="col">
    <label for="contact-service" class="font-heading-1 text-lg uppercase">Service Type</label>
    <select name="service" id="contact-service" class="form__input" required>
      <option value="">-- Select a Service --</option>
      <option value="Car Detailing">Car Detailing</option>
      <option value="Pressure Washing">Pressure Washing</option>
      <option value="Other">Other</option>
    </select>
    <div class="empty-feedback invalid-feedback text-warning text-sm mt-1">Please select a service type.</div>
  </div>

  <!-- Vehicle Type (optional) -->
  <div class="col">
    <label for="vehicle" class="font-heading-1 text-lg uppercase">Vehicle Type</label>
    <select name="vehicle" id="vehicle" class="form__input">
      <option value="">-- Select Vehicle Type (if applicable) --</option>
      <option value="Car">Car</option>
      <option value="SUV/Truck">SUV / Truck</option>
    </select>
  </div>

  <!-- Preferred Date -->
  <div class="col">
    <label for="date" class="font-heading-1 text-lg uppercase">Preferred Date</label>
    <input type="date" class="form__input" name="date" id="date" />
  </div>

  <!-- Message -->
  <div class="col">
    <label for="contact-message" class="font-heading-1 text-lg uppercase">Message</label>
    <textarea name="message" class="form__input" id="contact-message" rows="6" placeholder="Let us know how we can help!" required></textarea>
    <div class="empty-feedback invalid-feedback text-warning text-sm mt-1">Please enter your message.</div>
  </div>

  <!-- Submit -->
  <div class="col">
    <Button variant="primary" type="submit" class="w-full px-10 md:w-fit">Submit</Button>
  </div>

  <div id="result"></div>
</form>


<style is:inline>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }
  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }

</style>

<script is:inline>
	const form = document.getElementById('contact-form');
	const result = document.getElementById('result');

	form.addEventListener('submit', function (e) {
		e.preventDefault();
		form.classList.add("was-validated");

		// Validate before sending
		if (!form.checkValidity()) {
			form.querySelector(":invalid")?.focus();
			return;
		}

		const formData = new FormData(form);
		const object = Object.fromEntries(formData);
		const json = JSON.stringify(object);

		result.innerHTML = `
			<div class="flex items-center gap-2 text-primary-500 animate-pulse" aria-live="polite">
				<svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
				</svg>
				<span>✨ Sending your form... hang tight!</span>
			</div>
		`;

		fetch('https://api.web3forms.com/submit', {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				'Accept': 'application/json'
			},
			body: json
		})
		.then(async (response) => {
			const json = await response.json();
			if (response.status === 200) {
				result.innerHTML = `
					<div class="text-green-600 font-medium mt-2" aria-live="polite">✅ Thank you! Well'get back to you shortly! </div>
				`;
			} else {
				result.innerHTML = `
					<div class="text-red-600 font-medium mt-2" aria-live="polite">⚠️ ${json.message}</div>
				`;
			}
		})
		.catch(error => {
			console.error(error);
			result.innerHTML = `
				<div class="text-red-600 font-medium mt-2" aria-live="polite">⚠️ Something went wrong. Please try again.</div>
			`;
		})
		.finally(() => {
			form.reset();
			form.classList.remove("was-validated");

			// Auto-hide after 3s with smooth fade
			setTimeout(() => {
				result.classList.add("opacity-0", "transition-opacity", "duration-700");
			}, 3000);
		});
	});
</script>
